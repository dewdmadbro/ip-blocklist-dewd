# =============================================================================
# IP Aggregation & Multi-Country Filtering Configuration
# =============================================================================
##############     N O T E      ###############################################
### Make sure the paths in this .env file do not have any trailing comments.    # This is an example of a trailing comment
###############################################################################
#
# -----------------------------------------------------------------------------
# IP Blocklist Sources
# -----------------------------------------------------------------------------
# Add as many URL sources as needed. The system will automatically detect
# all of the LIST_# urls and download them. So enter as many as needed:
# -----------------------------------------------------------------------------
#
#
#
############################################
# ========== CORE / HIGH PRIORITY BLOCKLISTS ==========
# A compact aggregation of the most important IP threat feeds available. Each list serves a distinct purpose.
# Sources vary in scope, methodology, and region. Together, they represent a diverse, high-confidence foundation for network defense.
#
# Top Feeds: Core feeds include vetted sources with consistent updates and broad industry use.
############################################
#
# ---- FireHOL level 1 - high confidence, community curated ----
LIST_1=https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset
#
# ---- FireHOL level 2 - broader coverage (use if you want more aggressive blocking) ----
LIST_2=https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level2.netset
#
# ---- Emerging Threats - general threat IPs (broad, well-used) ----
LIST_3=https://rules.emergingthreats.net/fwrules/emerging-Block-IPs.txt
#
# ---- AbuseIPDB (community reported abusive IPs - top recent offenders) ----
LIST_4=https://raw.githubusercontent.com/borestad/blocklist-abuseipdb/main/abuseipdb-s100-30d.ipv4
#
# ---- FeodoTracker - focused on financial malware (high precision) ----
LIST_5=https://feodotracker.abuse.ch/downloads/ipblocklist_recommended.txt
#
# ---- Stamparm IPSUM - preprocessed: IPs found on 3+ blacklists (higher confidence) ----
LIST_6=https://raw.githubusercontent.com/stamparm/ipsum/master/levels/3.txt
#
# ---- Spamhaus DROP - Network hijacks/criminal operations ----
LIST_7=https://www.spamhaus.org/drop/drop.txt
#
# ---- Spamhaus EDROP - Extended network threats ----
LIST_8=https://www.spamhaus.org/drop/edrop.txt
#
#
#
############################################
# ====== ROMAINMARCOUX MALICIOUS-IP AGGREGATOR ======
# A high-volume, expertly curated compilation of malicious IP addresses, ideal for defensive deployments in edge security systems.
# Combines multiple open threat feeds into segmented files (131K or 300K entries max), optimized for firewall compatibility.
#
# Key Highlights: Focused on scanner and brute-force activity (WAN → LAN traffic blocking), and ranked sources—most frequently referenced IPs appear first.
############################################
#
# ---- RomainMarcoux malicious-ip - large, widely-used malicious IP aggregation (there is no one "full" file, file segments continue sequentially: e.g., “ab” begins where “aa” ends) ----
LIST_9=https://raw.githubusercontent.com/romainmarcoux/malicious-ip/refs/heads/main/full-300k-aa.txt
LIST_10=https://raw.githubusercontent.com/romainmarcoux/malicious-ip/refs/heads/main/full-300k-ab.txt
LIST_11=https://raw.githubusercontent.com/romainmarcoux/malicious-ip/refs/heads/main/full-300k-ac.txt
LIST_12=https://raw.githubusercontent.com/romainmarcoux/malicious-ip/refs/heads/main/full-300k-ad.txt
#
#
#
##########################################
# ====== SPECIALIZED USE-CASE LISTS ======
# Focused, narrowly scoped blocklists that serve targeted security objectives.
# Ideal for edge filtering, micro-segmentation, or supplementary enforcement.
#
# Tor Exit Nodes: Helps identify anonymized traffic often used to mask origins of probing or abuse.
##########################################
#
# ---- Tor exit nodes - block anonymized exit nodes if you want to block Tor-originated traffic ----
#LIST_13=https://opendbl.net/lists/tor-exit.list
#
# ---- CINSScore - "badguys" quick list (small, useful) ----
LIST_14=http://cinsscore.com/list/ci-badguys.txt
#
#
#
############################################
# ========== COMMUNITY / NICHE LISTS ==========
# Curated by independent researchers and smaller communities.
# These lists often reflect real-world abuse reports, honeypot data, or region-specific threats.
#
# Best for: Supplementing broader feeds with unique, often crowd-sourced threat intelligence.
############################################
#
# ---- LittleJake - USTC, NEUCERT, & AbuseIPDB score>75 variants (good for aggressive abuse blocking) ----
LIST_15=https://cdn.jsdelivr.net/gh/LittleJake/ip-blacklist/all_blacklist.txt
#
# ---- MagicTeaMC - general bad-IPs (community-curated) ----
#LIST_16=https://raw.githubusercontent.com/MagicTeaMC/bad-ips/refs/heads/main/bad-ips.txt
#LIST_17=https://raw.githubusercontent.com/MagicTeaMC/MCSTORM-IP/main/mcstorm-ip.txt
#
#
#
############################################
# ========== OPTIONAL / ENVIRONMENT-SPECIFIC ==========
# (Optional) You may want to double the content with additional aggregators. These are large combined sets (expect heavy overlap!).
# These lists are high-volume aggregations or environment-tailored feeds. Use when you want **maximum coverage** — but be aware of **heavy overlap** and potential **false positives**.
#
# Includes: Large aggregators, peer-to-peer blocklist, manually curated strict blocking, high-risk data, and additional FireHOL Level 3 filtering (aggressive filtering)
############################################
#
# ---- OpenDB aggregated list (useful but overlapping — keep if you want extra coverage) ----
#LIST_18=https://opendbl.net/lists/blocklistde-all.list
#
# ---- Bitwire-IT aggregated blocklist (general malicious IP aggregation — expect overlap with other sources) ----
#LIST_19=https://raw.githubusercontent.com/bitwire-it/ipblocklist/refs/heads/main/ip-list.txt
#
# ---- Bluetack-style blacklist generator (broad aggregation, legacy P2P-style blocklist format, aggressive coverage) ----
#LIST_20=https://raw.githubusercontent.com/actuallymentor/bluetack-ip-blacklist-generator/refs/heads/master/blacklist
#
# ---- Pallebone StrictBlock — curated, personal strict blocklist (community-maintained, manually updated) ----
#LIST_21=https://raw.githubusercontent.com/pallebone/StrictBlockPAllebone/refs/heads/master/BlockIP.txt
#
# ---- OXL Risk-DB Top 100k — large dataset of high-risk IPs (sorted by observed malicious activity) ----
#LIST_22=https://raw.githubusercontent.com/O-X-L/risk-db-lists/refs/heads/main/ip/top_100000.txt
#
# ---- FireHOL level 3 — very aggressive blocklist (large, overlaps with many lists, higher false-positive potential) ----
#LIST_23=https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level3.netset
#
#
#
###########################################
# ========== CUSTOM / YOUR-LISTS-HERE ==========
#LIST_24=
#
#LIST_25=
#
#LIST_26=
#
#
# -----------------------------------------------------------------------------
# Multi-Country Filtering Settings
# -----------------------------------------------------------------------------
# You can define multiple countries using these paired numbered variables:
# COUNTRY_ISO_CODE_1, COUNTRY_NAME_1, COUNTRY_ISO_CODE_2, COUNTRY_NAME_2, etc.
# -----------------------------------------------------------------------------
#
# EUROPEAN UNION EXAMPLE:
# Perfect for users who need multiple EU countries in their firewall rules
#
# Germany
#COUNTRY_ISO_CODE_1=DE
#COUNTRY_NAME_1=Germany
#
# France
#COUNTRY_ISO_CODE_2=FR
#COUNTRY_NAME_2=France
#
# Netherlands
#COUNTRY_ISO_CODE_3=NL
#COUNTRY_NAME_3=Netherlands
#
# Italy
#COUNTRY_ISO_CODE_4=IT
#COUNTRY_NAME_4=Italy
#
# Spain
#COUNTRY_ISO_CODE_5=ES
#COUNTRY_NAME_5=Spain
#
#
#
# NORTH AMERICAN EXAMPLE:
# Uncomment these if you want North American countries instead
#
# United States
#COUNTRY_ISO_CODE_6=US
#COUNTRY_NAME_6=United States
#
# Canada
#COUNTRY_ISO_CODE_7=CA
#COUNTRY_NAME_7=Canada
#
# Mexico
#COUNTRY_ISO_CODE_8=MX
#COUNTRY_NAME_8=Mexico
#
#
#
# ASIA-PACIFIC EXAMPLE:
# Uncomment these for Asia-Pacific region
#
# Japan
#COUNTRY_ISO_CODE_9=JP
#COUNTRY_NAME_9=Japan
#
# Australia
#COUNTRY_ISO_CODE_10=AU
#COUNTRY_NAME_10=Australia
#
# Singapore
#COUNTRY_ISO_CODE_11=SG
#COUNTRY_NAME_11=Singapore
#
# South Korea
#COUNTRY_ISO_CODE_12=KR
#COUNTRY_NAME_12=South Korea
#
#
# CUSTOM LIST EXAMPLE:
# Here is a custom list that is currently active
#
COUNTRY_ISO_CODE_200=US
COUNTRY_NAME_200=United States
#
COUNTRY_ISO_CODE_201=CA
COUNTRY_NAME_201=Canada
#
COUNTRY_ISO_CODE_202=GB
COUNTRY_NAME_202=United Kingdom
#
COUNTRY_ISO_CODE_203=AU
COUNTRY_NAME_203=Australia
#
COUNTRY_ISO_CODE_204=DE
COUNTRY_NAME_204=Germany
#
COUNTRY_ISO_CODE_205=KR
COUNTRY_NAME_205=South Korea
#
#
#################################
# LEGACY SINGLE COUNTRY SUPPORT:
# The old format still works for backward compatibility:
# COUNTRY_ISO_CODE=AU
# COUNTRY_NAME=Australia
#
# But it's recommended to use the numbered format for consistency
#
# -----------------------------------------------------------------------------
# Common Country Codes Cheat Sheet (ISO 3166-1 alpha-2)
# -----------------------------------------------------------------------------
# Europe: DE, FR, IT, ES, NL, BE, AT, SE, DK, FI, NO, PL, CZ, HU, etc.
# North America: US, CA, MX
# Asia: JP, CN, IN, KR, SG, TH, MY, ID, PH, VN, etc.
# Oceania: AU, NZ
# South America: BR, AR, CL, CO, PE, etc.
# Africa: ZA, EG, NG, KE, MA, etc.
#
# Full list available at: https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2
# You can also find country codes in the GeoIP data: https://datahub.io/core/geoip2-ipv4
# -----------------------------------------------------------------------------
#
# -----------------------------------------------------------------------------
# File Paths (You don't need to change these)
# -----------------------------------------------------------------------------
#
# Path where the GeoIP2 CSV database will be stored/cached
GEOIP_CSV_PATH=/data/geoip/geoip2-ipv4.csv
#
# Path to the full aggregated list of IP addresses is below
# this file is used as the input for the filtered country IPs 
# (aggregated.txt is generated by the aggregation script from Andrew Twin)
ALL_IPS_FROM_LISTS=/data/output/aggregated.txt
#
# -----------------------------------------------------------------------------
# Performance Tuning (Optional)
# -----------------------------------------------------------------------------
#
# Override the number of worker processes (default: auto-detect CPU count, max 4)
# Useful for systems with limited memory or different hardware configurations
# NUM_WORKERS=2
#
#
#
